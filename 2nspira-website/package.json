{
  "name": "2nspira-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "build:ci": "node scripts/build-ci.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "db:migrate:local": "wrangler d1 execute PORTAL_DB --local --file=migrations/0001_client_portal.sql",
    "db:migrate:payments:local": "wrangler d1 execute PORTAL_DB --local --file=migrations/0002_portal_payments.sql",
    "db:seed:local": "wrangler d1 execute PORTAL_DB --local --file=migrations/seed-demo.sql",
    "db:migrate:preview": "wrangler d1 execute PORTAL_DB --remote --config dist/server/wrangler.preview.json --file=migrations/0001_client_portal.sql",
    "db:migrate:payments:preview": "wrangler d1 execute PORTAL_DB --remote --config dist/server/wrangler.preview.json --file=migrations/0002_portal_payments.sql",
    "db:seed:preview": "wrangler d1 execute PORTAL_DB --remote --config dist/server/wrangler.preview.json --file=migrations/seed-demo.sql"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.11.0",
    "@stripe/stripe-js": "^9.17.0",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "stripe": "^22.6.2",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "type": "module",
  "overrides": {}
}
