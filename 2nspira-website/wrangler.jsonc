{
  "name": "2nspira-website",
  "account_id": "36a7807b2d8726b889873bab8b572113",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": ["2nspira.com/*", "www.2nspira.com/*"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  }
}
